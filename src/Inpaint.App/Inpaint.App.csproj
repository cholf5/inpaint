<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 应用版本：检查更新的比较基准（GitHub Release tag 带 v 前缀，比较时去掉），
         「关于」页展示同源。发版时改这里。 -->
    <Version>1.0.0</Version>
    <!-- XAML 绑定默认走编译期检查，绑定路径拼错直接构建失败 -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- 应用图标：Windows exe 内嵌图标（资源管理器/任务栏） -->
    <ApplicationIcon>Assets/app-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- 经 avares:// 协议嵌入程序集：XAML 里 Icon="avares://Inpaint.App/Assets/app-icon.ico" -->
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Inpaint.Core\Inpaint.Core.csproj" />
    <ProjectReference Include="..\Inpaint.Inference\Inpaint.Inference.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Inpaint.Tests" />
  </ItemGroup>
</Project>
